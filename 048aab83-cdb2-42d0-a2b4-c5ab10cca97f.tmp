<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#F4F6F8" />
  <title>Joma Hospitalar — Cartão de Visita</title>
  <meta name="description" content="Manutenção, calibração e segurança elétrica de equipamentos de saúde. Rua Minas, 34, sala 3 — Ribeirão Preto/SP e Região." />
  <!-- Ícones de marca (WhatsApp, Instagram, LinkedIn) e e-mail: Font Awesome Free 7.1.0, CC BY 4.0 — https://fontawesome.com/license/free -->

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
          colors: {
            joma: { petrol: '#1E5A75', aqua: '#7BC1C4', paper: '#F4F6F8' }
          }
        }
      }
    }
  </script>

  <style>
    html, body { background: #F4F6F8; -webkit-tap-highlight-color: transparent; }
    body { font-family: 'Inter', system-ui, sans-serif; color: #1E5A75; }

    /* Fundo sutil: grade técnica quase invisível + brilho aqua */
    .bg-tech {
      background-image:
        radial-gradient(60% 40% at 50% -5%, rgba(123,193,196,.28), transparent 70%),
        linear-gradient(rgba(30,90,117,.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(30,90,117,.035) 1px, transparent 1px);
      background-size: auto, 28px 28px, 28px 28px;
    }

    /* Entrada escalonada */
    @keyframes rise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
    .rise { opacity: 0; animation: rise .6s cubic-bezier(.2,.7,.2,1) forwards; }
    .d1 { animation-delay: .05s } .d2 { animation-delay: .12s } .d3 { animation-delay: .19s }
    .d4 { animation-delay: .26s } .d5 { animation-delay: .33s } .d6 { animation-delay: .40s }
    .d7 { animation-delay: .47s } .d8 { animation-delay: .54s }

    /* ===== Logo animada (usa a logo real) ===== */
    .logo-card { position: relative; overflow: hidden; }
    .logo-img {
      display: block; width: 100%; height: auto;
      animation: logo-reveal 1.3s cubic-bezier(.65,0,.35,1) .15s both;
    }
    @keyframes logo-reveal {
      from { clip-path: inset(0 100% 0 0); }
      to   { clip-path: inset(0 0 0 0); }
    }
    .logo-scan {
      position: absolute; top: 8%; bottom: 8%; left: 0; width: 2px; border-radius: 2px;
      background: linear-gradient(to bottom, transparent, #7BC1C4, transparent);
      box-shadow: 0 0 12px 3px rgba(123,193,196,.65);
      opacity: 0;
      animation: logo-scan 1.3s cubic-bezier(.65,0,.35,1) .15s both;
    }
    @keyframes logo-scan {
      0%   { left: 0;    opacity: 1; }
      92%  { opacity: 1; }
      100% { left: 100%; opacity: 0; }
    }
    .logo-card::after {
      content: ""; position: absolute; inset: 0; pointer-events: none;
      background: linear-gradient(105deg, transparent 38%, rgba(255,255,255,.75) 50%, transparent 62%);
      transform: translateX(-120%);
      animation: logo-sheen 7s ease-in-out 2.6s infinite;
    }
    @keyframes logo-sheen {
      0%   { transform: translateX(-120%); }
      18%  { transform: translateX(120%); }
      100% { transform: translateX(120%); }
    }

    /* Pulso do WhatsApp */
    @keyframes ping-soft {
      0%   { box-shadow: 0 0 0 0 rgba(255,255,255,.55); }
      70%  { box-shadow: 0 0 0 10px rgba(255,255,255,0); }
      100% { box-shadow: 0 0 0 0 rgba(255,255,255,0); }
    }
    .pulse-ring { animation: ping-soft 2.2s ease-out infinite; }

    /* ===== Ícones embutidos (não dependem de nenhuma fonte externa) ===== */
    .i { display: inline-block; flex: none; height: 1em; fill: currentColor; }
    .i-w448 { width: .875em; }
    .i-w512 { width: 1em; }
    .s { display: inline-block; flex: none; width: 1em; height: 1em; fill: none; stroke: currentColor;
         stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }

    /* Símbolos da marca (enviados pelo cliente), pintados com a cor do texto:
       assim acompanham o hover (petróleo → branco) como qualquer outro ícone */
    :root {
      --m-joma: url("data:image/png;base64,");
      --m-care: url("data:image/png;base64,");
    }
    .sym {
      display: inline-block; flex: none; background-color: currentColor;
      -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
      -webkit-mask-position: center; mask-position: center;
      -webkit-mask-size: contain; mask-size: contain;
    }
    .sym-joma { width: 30px; height: 19px; -webkit-mask-image: var(--m-joma); mask-image: var(--m-joma); }
    .sym-care { width: 23px; height: 23px; -webkit-mask-image: var(--m-care); mask-image: var(--m-care); }

    /* Cartões de ação */
    .action {
      transition: transform .25s cubic-bezier(.2,.7,.2,1), box-shadow .25s ease, border-color .25s ease, background-color .25s ease;
    }
    .action:hover { transform: translateY(-2px); }
    .action:active { transform: scale(.985); }
    .action .chev { transition: transform .25s ease, color .25s ease; }
    .action:hover .chev { transform: translateX(3px); }
    .action .ico { transition: background-color .25s ease, color .25s ease, transform .25s ease; }
    .action:hover .ico { transform: scale(1.06); }

    .shadow-soft { box-shadow: 0 1px 2px rgba(30,90,117,.05), 0 6px 18px -8px rgba(30,90,117,.18); }
    .shadow-soft-hover:hover { box-shadow: 0 2px 4px rgba(30,90,117,.06), 0 14px 28px -12px rgba(30,90,117,.28); }

    @media (prefers-reduced-motion: reduce) {
      /* A animação da logo é discreta e continua ativa de propósito (marca da empresa) */
      .rise { animation: none; opacity: 1; }
      .pulse-ring { animation: none; }
      .action, .action * { transition: none !important; }
    }
  </style>
</head>

<body class="min-h-dvh bg-tech antialiased">

  <!-- Biblioteca de ícones (invisível) -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <defs>
      <symbol id="ic-whatsapp" viewBox="0 0 448 512"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157m-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1s56.2 81.2 56.1 130.5c0 101.8-84.9 184.6-186.6 184.6m101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8s-14.3 18-17.6 21.8c-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7s-12.5-30.1-17.1-41.2c-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2s-9.7 1.4-14.8 6.9c-5.1 5.6-19.4 19-19.4 46.3s19.9 53.7 22.6 57.4c2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4s4.6-24.1 3.2-26.4c-1.3-2.5-5-3.9-10.5-6.6"/></symbol>
      <symbol id="ic-instagram" viewBox="0 0 448 512"><path d="M224.3 141a115 115 0 1 0-.6 230 115 115 0 1 0 .6-230m-.6 40.4a74.6 74.6 0 1 1 .6 149.2 74.6 74.6 0 1 1-.6-149.2m93.4-45.1a26.8 26.8 0 1 1 53.6 0 26.8 26.8 0 1 1-53.6 0m129.7 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8M399 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1"/></symbol>
      <symbol id="ic-linkedin" viewBox="0 0 448 512"><path d="M100.3 448H7.4V148.9h92.9zM53.8 108.1C24.1 108.1 0 83.5 0 53.8c0-14.3 5.7-27.9 15.8-38S39.6 0 53.8 0s27.9 5.7 38 15.8 15.8 23.8 15.8 38c0 29.7-24.1 54.3-53.8 54.3M447.9 448h-92.7V302.4c0-34.7-.7-79.2-48.3-79.2-48.3 0-55.7 37.7-55.7 76.7V448h-92.8V148.9h89.1v40.8h1.3c12.4-23.5 42.7-48.3 87.9-48.3 94 0 111.3 61.9 111.3 142.3V448z"/></symbol>
      <symbol id="ic-envelope" viewBox="0 0 512 512"><path d="M48 64C21.5 64 0 85.5 0 112c0 15.1 7.1 29.3 19.2 38.4l208 156a48 48 0 0 0 57.6 0l208-156c12.1-9.1 19.2-23.3 19.2-38.4 0-26.5-21.5-48-48-48zM0 196v188c0 35.3 28.7 64 64 64h384c35.3 0 64-28.7 64-64V196L313.6 344.8c-34.1 25.6-81.1 25.6-115.2 0z"/></symbol>
    </defs>
  </svg>

  <main class="mx-auto flex min-h-dvh w-full max-w-md flex-col justify-between gap-4 px-4 pb-[max(1rem,env(safe-area-inset-bottom))] pt-[max(1.5rem,env(safe-area-inset-top))]">

    <!-- ============ TOPO / IDENTIDADE ============ -->
    <header class="flex flex-col items-center text-center">
      <h1 class="sr-only">Joma Hospitalar</h1>

      <div class="rise d1 logo-card w-full max-w-[310px] rounded-3xl border border-joma-petrol/10 bg-white px-3 py-3 shadow-soft">
        <img class="logo-img" alt="Joma Hospitalar" width="900" height="271"
             src="data:image/jpeg;base64," />
        <span class="logo-scan" aria-hidden="true"></span>
      </div>

      <p class="rise d3 mt-4 max-w-[19rem] text-[13.5px] font-medium leading-snug text-joma-petrol/75">
        Manutenção, Calibração e Segurança Elétrica de Equipamentos de Saúde
      </p>

      <!-- Endereço e região -->
      <a href="https://www.google.com/maps/search/?api=1&query=Rua+Minas+34+Ribeir%C3%A3o+Preto+SP"
         target="_blank" rel="noopener"
         class="rise d4 group mt-3 inline-flex items-start gap-2 text-left text-[12px] font-medium leading-snug text-joma-petrol/75 transition hover:text-joma-petrol">
        <svg class="s mt-0.5 text-[14px] text-joma-aqua" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
        <span>
          Rua Minas, nº 34, sala 3 · Ribeirão Preto/SP
          <span class="block text-[11px] text-joma-petrol/55">Atendimento em Ribeirão Preto/SP e Região</span>
        </span>
      </a>
    </header>

    <!-- ============ AÇÕES ============ -->
    <nav class="flex flex-col gap-2.5" aria-label="Contatos e links">

      <!-- 1. WhatsApp (destaque) -->
      <a id="btn-whatsapp"
         href="https://wa.me/5516997045262?text=Ol%C3%A1%2C%20gostaria%20de%20solicitar%20um%20or%C3%A7amento%20t%C3%A9cnico."
         target="_blank" rel="noopener"
         class="action rise d5 group relative flex items-center gap-3 overflow-hidden rounded-2xl bg-gradient-to-br from-[#1E5A75] to-[#17475c] px-3.5 py-3.5 text-white shadow-[0_10px_24px_-10px_rgba(30,90,117,.7)] hover:shadow-[0_16px_30px_-10px_rgba(30,90,117,.8)]">
        <span aria-hidden="true" class="pointer-events-none absolute -right-8 -top-10 h-28 w-28 rounded-full bg-joma-aqua/20 blur-2xl"></span>
        <span class="ico pulse-ring relative flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white/15 text-[24px]">
          <svg class="i i-w448" aria-hidden="true"><use href="#ic-whatsapp"/></svg>
        </span>
        <span class="relative min-w-0 flex-1">
          <span class="block text-[15px] font-bold leading-tight">Solicitar Orçamento Técnico</span>
          <span class="mt-0.5 block text-[12px] font-medium text-white/75">Fale direto no WhatsApp</span>
        </span>
        <svg class="chev s relative text-[15px] text-joma-aqua" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>

      <!-- 2. Website (símbolo da Joma) -->
      <a href="https://jomahospitalar.com.br" target="_blank" rel="noopener"
         class="action rise d6 group flex items-center gap-3 rounded-2xl border border-joma-petrol/10 bg-white px-3.5 py-3 shadow-soft shadow-soft-hover hover:border-joma-aqua/70">
        <span class="ico flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-joma-aqua/20 text-joma-petrol group-hover:bg-joma-petrol group-hover:text-white">
          <span class="sym sym-joma" aria-hidden="true"></span>
        </span>
        <span class="min-w-0 flex-1">
          <span class="block text-[14px] font-bold leading-tight text-joma-petrol">Website Oficial</span>
          <span class="mt-0.5 block truncate text-[11.5px] font-medium text-joma-petrol/60">Conheça nossos serviços regulamentados</span>
        </span>
        <svg class="chev s text-xs text-joma-petrol/30 group-hover:text-joma-aqua" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
      </a>

      <!-- 3. E-mail -->
      <a href="mailto:jomahospitalar@gmail.com"
         class="action rise d6 group flex items-center gap-3 rounded-2xl border border-joma-petrol/10 bg-white px-3.5 py-3 shadow-soft shadow-soft-hover hover:border-joma-aqua/70">
        <span class="ico flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-joma-aqua/20 text-[18px] text-joma-petrol group-hover:bg-joma-petrol group-hover:text-white">
          <svg class="i i-w512" aria-hidden="true"><use href="#ic-envelope"/></svg>
        </span>
        <span class="min-w-0 flex-1">
          <span class="block text-[14px] font-bold leading-tight text-joma-petrol">E-mail Institucional</span>
          <span class="mt-0.5 block truncate text-[11.5px] font-medium text-joma-petrol/60">Envio de editais e laudos</span>
        </span>
        <svg class="chev s text-xs text-joma-petrol/30 group-hover:text-joma-aqua" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
      </a>

      <!-- 4. JomaCare (símbolo do JomaCare) -->
      <a href="https://www.jomacare.com.br" target="_blank" rel="noopener"
         class="action rise d7 group flex items-center gap-3 rounded-2xl border border-joma-petrol/10 bg-white px-3.5 py-3 shadow-soft shadow-soft-hover hover:border-joma-aqua/70">
        <span class="ico flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-joma-aqua/20 text-joma-petrol group-hover:bg-joma-petrol group-hover:text-white">
          <span class="sym sym-care" aria-hidden="true"></span>
        </span>
        <span class="min-w-0 flex-1">
          <span class="block text-[14px] font-bold leading-tight text-joma-petrol">JomaCare</span>
          <span class="mt-0.5 block truncate text-[11.5px] font-medium text-joma-petrol/60">Sistema de gestão · Área do cliente</span>
        </span>
        <svg class="chev s text-xs text-joma-petrol/30 group-hover:text-joma-aqua" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg>
      </a>
    </nav>

    <!-- ============ QR CODE / COMPARTILHAR ============ -->
    <section class="rise d8 flex items-center gap-3.5 rounded-2xl border border-joma-petrol/10 bg-white p-3 shadow-soft" aria-label="Compartilhar contato">
      <div class="shrink-0 rounded-xl border border-joma-petrol/10 bg-[#F8F9FA] p-2">
        <div id="qrcode" class="h-[92px] w-[92px] [&>canvas]:!h-full [&>canvas]:!w-full [&>img]:!h-full [&>img]:!w-full" aria-label="QR Code para o WhatsApp da Joma Hospitalar" role="img"></div>
      </div>
      <div class="min-w-0">
        <p class="text-[10.5px] font-bold uppercase tracking-[.14em] text-joma-aqua">Salve nosso contato</p>
        <p class="mt-1 text-[12.5px] font-medium leading-snug text-joma-petrol/80">
          Aproxime a câmera de outro celular para salvar o contato
        </p>
      </div>
    </section>

    <!-- ============ RODAPÉ: ÍCONES ============ -->
    <footer class="rise d8 flex flex-col items-center gap-2 pb-1">
      <div class="flex items-center gap-2.5">
        <a href="https://wa.me/5516997045262?text=Ol%C3%A1%2C%20gostaria%20de%20solicitar%20um%20or%C3%A7amento%20t%C3%A9cnico."
           target="_blank" rel="noopener" aria-label="WhatsApp"
           class="flex h-11 w-11 items-center justify-center rounded-full border border-joma-petrol/15 bg-white/70 text-[20px] text-joma-petrol/80 transition hover:-translate-y-0.5 hover:border-joma-aqua hover:bg-joma-aqua/15 hover:text-joma-petrol">
          <svg class="i i-w448" aria-hidden="true"><use href="#ic-whatsapp"/></svg>
        </a>
        <a href="mailto:jomahospitalar@gmail.com" aria-label="E-mail"
           class="flex h-11 w-11 items-center justify-center rounded-full border border-joma-petrol/15 bg-white/70 text-[18px] text-joma-petrol/80 transition hover:-translate-y-0.5 hover:border-joma-aqua hover:bg-joma-aqua/15 hover:text-joma-petrol">
          <svg class="i i-w512" aria-hidden="true"><use href="#ic-envelope"/></svg>
        </a>
        <a href="https://www.instagram.com/jomahospitalar/" target="_blank" rel="noopener" aria-label="Instagram @jomahospitalar"
           class="flex h-11 w-11 items-center justify-center rounded-full border border-joma-petrol/15 bg-white/70 text-[20px] text-joma-petrol/80 transition hover:-translate-y-0.5 hover:border-joma-aqua hover:bg-joma-aqua/15 hover:text-joma-petrol">
          <svg class="i i-w448" aria-hidden="true"><use href="#ic-instagram"/></svg>
        </a>
        <a href="https://www.jomacare.com.br" target="_blank" rel="noopener" aria-label="JomaCare"
           class="flex h-11 w-11 items-center justify-center rounded-full border border-joma-petrol/15 bg-white/70 text-joma-petrol/80 transition hover:-translate-y-0.5 hover:border-joma-aqua hover:bg-joma-aqua/15 hover:text-joma-petrol">
          <span class="sym sym-care" aria-hidden="true"></span>
        </a>
        <a href="https://www.linkedin.com/company/joma-hospitalar" target="_blank" rel="noopener" aria-label="LinkedIn Joma Hospitalar"
           class="flex h-11 w-11 items-center justify-center rounded-full border border-joma-petrol/15 bg-white/70 text-[19px] text-joma-petrol/80 transition hover:-translate-y-0.5 hover:border-joma-aqua hover:bg-joma-aqua/15 hover:text-joma-petrol">
          <svg class="i i-w448" aria-hidden="true"><use href="#ic-linkedin"/></svg>
        </a>
      </div>
      <p class="text-[10.5px] font-medium text-joma-petrol/45">© 2026 Joma Hospitalar</p>
    </footer>
  </main>

  <!-- QR Code (qrcode.js via CDN) -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <script>
    (function () {
      var link = document.getElementById('btn-whatsapp').href;
      var el = document.getElementById('qrcode');
      if (typeof QRCode === 'undefined' || !el) return;
      new QRCode(el, {
        text: link,
        width: 256,
        height: 256,
        colorDark: '#1E5A75',
        colorLight: '#F8F9FA',
        correctLevel: QRCode.CorrectLevel.M
      });
    })();
  </script>

  <!-- Reinicia o efeito da logo: ao abrir, ao voltar para a aba/app e ao tocar na logo -->
  <script>
    (function () {
      var card = document.querySelector('.logo-card');
      if (!card) return;
      var parts = [card.querySelector('.logo-img'), card.querySelector('.logo-scan')];
      function replay() {
        parts.forEach(function (el) { if (el) el.style.animation = 'none'; });
        void card.offsetWidth;
        parts.forEach(function (el) { if (el) el.style.animation = ''; });
      }
      window.addEventListener('pageshow', function (e) { if (e.persisted) replay(); });
      document.addEventListener('visibilitychange', function () {
        if (document.visibilityState === 'visible') replay();
      });
      card.addEventListener('click', replay);
    })();
  </script>
</body>
</html>
